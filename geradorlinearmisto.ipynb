      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x=5\n",
        "x1=np.array([x])\n",
        "n=16\n",
        "a=11\n",
        "c=7\n",
        "m=pow(2,5)\n",
        "for i in range(n):\n",
        "    x=(a*x+c)%m\n",
        "    x1=np.append(x1,x)\n",
        "print(x1)\n",
        "ind=np.arange(n+1)\n",
        "plt.bar(ind, x1)\n",
        "plt.show()"
      ],
